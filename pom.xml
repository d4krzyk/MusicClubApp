<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Parent = Spring Boot. Dzieki niemu nie musimy podawac wersji przy wiekszosci
        zaleznosci - Spring Boot pilnuje, zeby wersje byly ze soba zgodne.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.musicclubapp</groupId>
    <artifactId>musicclubapp</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>musicclubapp</name>
    <description>Aplikacja do poznawania ludzi po podobnym guscie muzycznym (Spotify)</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- KROK 2: JPA = mapowanie klas Javy na tabele w bazie (wymaganie nr 1) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Sterownik PostgreSQL - pozwala Javie gadac z baza z docker-compose -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Web = kontrolery REST (@RestController). Potrzebne od KROKU 3 wzwyz -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation: @NotBlank, @Email itd. (wymaganie nr 9) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Testy: JUnit 5 + AssertJ + MockMvc (wymagania nr 13, 14, 25) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            H2 tylko do testow. Testy @DataJpaTest odpalaja sie wtedy na bazie
            w pamieci - nie trzeba miec wlaczonego Dockera zeby puscic `mvn test`.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
