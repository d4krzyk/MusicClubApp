<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Parent = Spring Boot. Dzieki niemu nie musimy podawac wersji przy wiekszosci
        zaleznosci - Spring Boot pilnuje, zeby wersje byly ze soba zgodne.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.musicclubapp</groupId>
    <artifactId>musicclubapp</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>musicclubapp</name>
    <description>Aplikacja do poznawania ludzi po podobnym guscie muzycznym (Spotify)</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- KROK 2: JPA = mapowanie klas Javy na tabele w bazie (wymaganie nr 1) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Sterownik PostgreSQL - pozwala Javie gadac z baza z docker-compose -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Web = kontrolery REST (@RestController). Potrzebne od KROKU 3 wzwyz -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation: @NotBlank, @Email itd. (wymaganie nr 9) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- KROK 3: Spring Security - logowanie, rejestracja, hashowanie hasel (wymaganie nr 15) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            KROK 6: Actuator - wystawia /actuator/health, czyli odpowiedz
            na pytanie "czy aplikacja juz wstala i widzi baze?".

            Potrzebne Dockerowi: dzieki temu compose wie, kiedy backend jest
            NAPRAWDE gotowy, i dopiero wtedy uruchamia frontend. Bez tego
            "kontener wystartowal" znaczy tylko "proces ruszyl" - a Spring
            wstaje kilkanascie sekund i przez ten czas oddawalby bledy.

            Wystawiamy WYLACZNIE health (patrz application.properties) -
            reszta endpointow Actuatora pokazuje szczegoly konfiguracji
            i nie ma po co byc dostepna.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Swagger / OpenAPI (wymaganie nr 24). Wyklad 4 (slajd 19-20) mowi, ze
            do API w stylu RPC powinna powstac dokumentacja - np. wlasnie Swagger.
            Po uruchomieniu aplikacji: http://localhost:8080/swagger-ui.html
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!-- Testy: JUnit 5 + AssertJ + MockMvc (wymagania nr 13, 14, 25) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pozwala udawac zalogowanego uzytkownika w testach (@WithMockUser) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            H2 tylko do testow. Testy @DataJpaTest odpalaja sie wtedy na bazie
            w pamieci - nie trzeba miec wlaczonego Dockera zeby puscic `mvn test`.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Flyway: migracje bazy. Wchodzi do gry TYLKO w profilu produkcyjnym
            (spring.flyway.enabled=false w application.properties).

            W pracy nad kodem zostaje ddl-auto=update, bo przy ciaglych zmianach
            encji pisanie migracji do kazdej proby byloby udreka. Na serwerze
            jest odwrotnie: tam schemat ma byc przewidywalny i powtarzalny,
            a Hibernate ma go tylko sprawdzac, nie zmieniac.

            Od Flyway 10 sterownik do PostgreSQL jest osobnym artefaktem -
            bez niego migracje nie ruszaja z bledem o nieznanej bazie.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
