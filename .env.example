# =============================================================================
#  Wzor pliku ze zmiennymi srodowiskowymi.
#
#  Uzycie:
#      cp .env.example .env      (w PowerShellu: copy .env.example .env)
#  i wpisz wlasne wartosci.
#
#  Plik .env jest w .gitignore - prawdziwe hasla nie trafiaja do repozytorium.
#  Ten plik trafia, bo pokazuje, JAKIE zmienne trzeba ustawic, nie zdradzajac
#  zadnej prawdziwej wartosci. `docker compose` czyta .env automatycznie.
#
#  Kazda z tych zmiennych ma wartosc domyslna w docker-compose.yml, wiec bez
#  pliku .env calosc tez wstanie - tyle ze na hasłach do nauki.
#
#  NA SERWERZE JEST INACZEJ. docker-compose.prod.yml celowo NIE ma wartosci
#  domyslnych dla hasel i klucza: bez pliku .env nie wystartuje i powie, czego
#  brakuje. Lepiej, zeby nie ruszyl, niz zeby ruszyl z kluczem z repozytorium.
# =============================================================================

# --- Baza danych -------------------------------------------------------------
POSTGRES_DB=musicclub
POSTGRES_USER=musicclub
POSTGRES_PASSWORD=zmien-mnie-na-wlasne-haslo

# --- Pierwszy administrator --------------------------------------------------
# Zaklada sie sam przy pierwszym starcie, gdy w bazie nie ma jeszcze admina.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@musicclub.local
ADMIN_PASSWORD=zmien-mnie-przed-oddaniem

# --- "Zapamietaj mnie" -------------------------------------------------------
# Klucz do podpisywania ciasteczka. Dowolny dlugi losowy ciag.
# Po jego zmianie wszyscy zostana wylogowani - to normalne.
#
# TO NIE JEST ZWYKLE HASLO. Kto zna ten klucz, podpisze sobie ciasteczko
# "zapamietaj mnie" na dowolna nazwe uzytkownika i zaloguje sie jako
# ktokolwiek - nie znajac zadnego hasla. Na serwerze MUSI byc wlasny.
#
# Wygenerowanie:
#     openssl rand -base64 48
# albo w PowerShellu:
#     [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
REMEMBER_ME_KEY=zmien-mnie-na-dlugi-losowy-ciag

# --- Last.fm (import historii sluchania) -------------------------------------
#
# Klucz zakladasz w minute na https://www.last.fm/api/account/create
# Wystarczy samo "API key" - "shared secret" nie jest potrzebny, bo czytamy
# WYLACZNIE dane publiczne i nie logujemy nikogo przez Last.fm.
#
# Bez tej zmiennej aplikacja dziala normalnie: znika tylko przycisk
# "Import z Last.fm" na profilu. Reczne dodawanie ulubionych z katalogu
# Deezera nie wymaga zadnego klucza - Deezer udostepnia katalog otwarcie.
#
# Ten sam klucz daje gatunki do widoku "Dla ciebie" w zakladce Wydarzenia:
# i ulubionym artystom, i wykonawcom koncertow. Bez niego gatunki sa
# porownywane tylko z ogolnymi etykietami Ticketmastera.
LASTFM_API_KEY=

# --- Ticketmaster (zakladka Wydarzenia) --------------------------------------
#
# Darmowy klucz: zarejestruj sie na https://developer.ticketmaster.com,
# potem "My Apps" -> aplikacja "<twoj-login>-App" -> "Consumer Key".
# Limit to 5000 zapytan dziennie; import zuzywa okolo 100.
#
# Bez tej zmiennej zakladka Wydarzenia jest pusta, reszta dziala normalnie.
TICKETMASTER_API_KEY=

# --- Poczta: potwierdzanie adresu e-mail --------------------------------------
#
# Z tymi zmiennymi nowe konto dostaje wiadomosc z linkiem i nie zaloguje sie,
# dopoki go nie kliknie. Bez MAIL_HOST poczta jest wylaczona, a konta dzialaja
# od razu. Konta zalozone przed wlaczeniem poczty nie musza niczego potwierdzac.
#
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=twoj@gmail.com,
# MAIL_PASSWORD = "haslo aplikacji" (Konto Google -> Bezpieczenstwo ->
# Weryfikacja dwuetapowa -> Hasla aplikacji). NIE zwykle haslo do Gmaila.
# Szczegoly i inne mozliwosci (Brevo) - docs/WDROZENIE.md.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Nadawca, np. MusicClub <twoj@gmail.com>. Pusty = MAIL_USERNAME.
MAIL_FROM=
# Adres strony w linkach, np. https://musicclub.twojadomena.pl
APP_PUBLIC_URL=

# --- Powiadomienia push na telefon (przypomnienia o wydarzeniach) ------------
#
# Para kluczy VAPID - generuje sie RAZ i potem sie jej nie zmienia (po zmianie
# kazdy musi wlaczyc powiadomienia od nowa). Najprosciej:
#   npx web-push generate-vapid-keys
# albo samym openssl - polecenia w docs/WDROZENIE.md. Klucz prywatny jest
# tajny jak haslo. Bez kluczy przypomnienia sa tylko w dzwonku.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt dla uslug push (Google, Apple): mailto:twoj@adres albo https://...
# Pusty = APP_PUBLIC_URL, o ile zaczyna sie od https://.
VAPID_SUBJECT=

# --- Tylko dla serwera (docker-compose.prod.yml) ------------------------------
#
# Domena - potrzebna WYLACZNIE przy profilu "domena", czyli gdy HTTPS robi
# Caddy. Przy tunelu Cloudflare zostaw pusta: adres nadaje wtedy Cloudflare.
DOMENA=

# Swagger, czyli klikalna dokumentacja API. Na serwerze domyslnie wylaczony -
# to kompletna mapa API razem z ksztaltem kazdego zapytania. Wlacz tylko,
# jesli naprawde go potrzebujesz.
SWAGGER_ENABLED=false

# --- Uruchamianie backendu POZA Dockerem (IntelliJ, mvn spring-boot:run) ------
#
# W docker compose backend dostaje te wartosci automatycznie (patrz sekcja
# `backend:` w docker-compose.yml - tam DB_HOST to na sztywno "db", czyli
# nazwa kontenera bazy). NIE ustawiaj ich w .env, bo compose i tak je nadpisze.
#
# Sa tu wypisane po to, zeby bylo wiadomo, czego szuka aplikacja, gdy
# odpalasz ja recznie przy bazie z `docker compose up -d db`. Wartosci
# domyslne z application.properties i tak pasuja do tego przypadku,
# wiec zwykle nie trzeba ustawiac niczego:
#
#   DB_HOST=localhost
#   DB_PORT=5432
#   DB_NAME=musicclub
#   DB_USER=musicclub
#   DB_PASSWORD=musicclub
#   UPLOADS_DIR=uploads
