# Skopiuj ten plik jako .env  ->  cp .env.example .env
# Plik .env jest w .gitignore, wiec prawdziwe hasla nie trafia do repozytorium.
# docker compose czyta .env automatycznie.

POSTGRES_DB=musicclub
POSTGRES_USER=musicclub
POSTGRES_PASSWORD=musicclub

# Te same dane widziane od strony aplikacji Spring
# (DB_HOST=localhost przy uruchamianiu z IntelliJ, DB_HOST=db w KROKU 6)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=musicclub
DB_USER=musicclub
DB_PASSWORD=musicclub
