+# =============================================================================
+#  KROK 2 planu: polaczenie Spring Boota z baza PostgreSQL
+# =============================================================================
+spring.application.name=musicclubapp
 
+# --- POLACZENIE Z BAZA ---------------------------------------------------
+# Format: jdbc:postgresql://HOST:PORT/NAZWA_BAZY
+# ${ZMIENNA:wartosc_domyslna} - Spring najpierw szuka zmiennej srodowiskowej,
+# a jak jej nie ma, bierze wartosc po dwukropku. Dzieki temu ten sam plik
+# dziala i lokalnie (localhost), i pozniej w Dockerze (host = "db").
+spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:musicclub}
+spring.datasource.username=${DB_USER:musicclub}
+spring.datasource.password=${DB_PASSWORD:musicclub}
+
+# --- JPA / HIBERNATE -----------------------------------------------------
+# ddl-auto=update -> Hibernate sam tworzy/dopisuje tabele na podstawie encji.
+#   Wygodne na etapie nauki i pisania projektu.
+#   (validate = tylko sprawdza zgodnosc, none = nic nie robi, create-drop = kasuje przy stopie)
 spring.jpa.hibernate.ddl-auto=update
+
+# Wypisuje w konsoli kazde zapytanie SQL, ktore Hibernate wysyla do bazy.
+# Zostaw wlaczone - najlepszy sposob, zeby ZOBACZYC co JPA robi pod spodem.
 spring.jpa.show-sql=true
+spring.jpa.properties.hibernate.format_sql=true
+
+# Nie trzymaj polaczenia z baza otwartego przez caly czas obslugi requestu.
+# Wymusza swiadome ladowanie danych w serwisie (mniej bledow LazyInitializationException
+# przez przypadek, wiecej kontroli).
+spring.jpa.open-in-view=false
 
-spring.messages.basename=messages
+# --- LOGOWANIE -----------------------------------------------------------
+# Pokazuje wartosci podstawiane pod znaki "?" w SQL-u
+logging.level.org.hibernate.orm.jdbc.bind=TRACE
 
-app.jwt.secret=changeThisSecretToAtLeast32CharsLong
-app.jwt.expirationMs=3600000
-app.cors.allowed-origins=http://localhost:3000
-app.spotify.client-id=YOUR_SPOTIFY_CLIENT_ID
-app.spotify.client-secret=YOUR_SPOTIFY_CLIENT_SECRET
-app.spotify.token-uri=https://accounts.spotify.com/api/token
-app.spotify.api-base=https://api.spotify.com/v1
+# --- SERWER --------------------------------------------------------------
+server.port=8080
